{
  "name": "tabby-ssh-proxy-selector",
  "version": "0.1.0",
  "description": "Tabby plugin: use internal proxy socket for selected SSH profiles",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/proxy-socket.test.cjs tests/routing.test.cjs tests/route-scroll.test.cjs tests/release-version.test.cjs",
    "prepack": "npm run build",
    "pack": "npm pack",
    "pack:release": "node scripts/pack-release.cjs"
  },
  "keywords": [
    "tabby",
    "tabby-plugin",
    "ssh",
    "proxy",
    "proxycommand"
  ],
  "author": {
    "name": "ppcat"
  },
  "dependencies": {
    "socks": "^2.8.7"
  },
  "bundleDependencies": [
    "socks"
  ],
  "devDependencies": {
    "@types/node": "^22.13.14",
    "fflate": "0.8.2",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
